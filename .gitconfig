[user]
	name = Yoelvis Oliveros
	email = yoelvisoliveros@gmail.com
[credential]
	helper = 
  username = yoliveros
[credential "github.com"]
	useHttpPath = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[rerere]
	enable = true
[core]
	editor = nvim
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
